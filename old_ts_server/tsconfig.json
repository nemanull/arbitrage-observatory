{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    // TS 6 no longer implicitly pulls in every package under node_modules/@types.
    // Global type packages must be listed.
    // Module types such as express still resolve through their import statements.
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    // TS 6+ requires rootDir to be explicit. This config covers src/ *and*
    // test/ (used by eslint's type-aware rules and ts-jest), so it must be the
    // package root; tsconfig.build.json narrows it to ./src for emit.
    "rootDir": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
