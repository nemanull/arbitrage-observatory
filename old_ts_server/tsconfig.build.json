{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Keep the incremental build info inside outDir so `clean` removes it with
    // dist. If it lives outside, a cleaned dist + stale buildinfo makes the
    // compiler believe everything is up to date and emit nothing.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  // Without this, prisma.config.ts becomes a program root outside rootDir and the build fails.
  // The failed build also emits a stray prisma.config.js that the Prisma CLI loads instead of the source.
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
