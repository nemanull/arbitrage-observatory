# Copy to .env and fill in real values.

NODE_ENV=development
PORT=3000

# Ports match the root docker-compose.yaml, which avoids the defaults already used on this host.
DATABASE_URL=postgresql://observatory:observatory@localhost:5532/observatory
REDIS_URL=redis://localhost:6390

# SigNoz ingests OpenTelemetry logs, traces, and metrics over OTLP.
# The port matches infra/signoz/compose.yaml, which shifts it off the 4318 default.
# Leave this empty to run without exporting, in which case logs only reach the terminal.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4418
OTEL_SERVICE_NAME=observatory-server

# Console filter, for example info or info,server::engine=debug.
# A bare debug also prints the exporter's own HTTP client, so scope debug to the server crate.
RUST_LOG=info
# What reaches SigNoz, independent of the console.
OTEL_LOG_LEVEL=info
