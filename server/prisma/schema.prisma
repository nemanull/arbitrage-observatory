// Every rate is a signed integer in parts per million.
// A rebate is a negative rate.
// Prices and ppm readings taken from the engine are Float, because the engine holds them in Float64Array and a double round trips through JSON without loss.
// The datasource URL lives in prisma.config.ts.

generator client {
  provider = "prisma-client"

  // Must sit under the build rootDir, which is src.
  output = "../src/db/generated/prisma"

  // The server is CommonJS, and this generator emits ESM by default.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Venue {
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  id      Int     @id @default(autoincrement())
  slug    String  @unique
  name    String
  enabled Boolean @default(true)

  markets Market[]
}

model Pair {
  createdAt DateTime @default(now())

  id     Int    @id @default(autoincrement())
  base   String
  quote  String
  /// The PairKey the engine uses, spelled "BTC|USDT"
  symbol String @unique

  markets Market[]

  @@unique([base, quote])
}

/// One venue's listing of one pair, and the row Market in src/engine/cluster/types.ts is built from
model Market {
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  id      Int @id @default(autoincrement())
  venueId Int
  pairId  Int

  /// Spelled exactly as the venue's socket spells it, for example "BTCUSDT"
  rawMarketId String
  /// A linear contract settles in the quote asset, an inverse one settles in the base asset
  linear      Boolean @default(true)
  makerPpm    Int
  takerPpm    Int
  /// Cleared by the market sync job once the venue stops listing this market
  active      Boolean @default(true)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  pair  Pair  @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([venueId, rawMarketId])
  @@unique([venueId, pairId])
  @@index([pairId, active])
}

/// One closed Opportunity from src/engine/opportunity/types.ts, so one episode during which a route stayed profitable rather than a single moment.
/// Every price and every ppm reading here is already fee adjusted.
/// The legs are recorded by slug rather than by foreign key, so a row keeps its meaning after a delisting or a catalog rebuild, and the writer needs no id lookup.
enum OpportunityCloseReason {
  spread_collapsed
  /// The fresh edge fell below the closure threshold while the raw cross still cleared it
  fresh_edge_collapsed
  feed_down
  age_cap
  shutdown
}

/// Why a route opened without an anchor reading, see src/engine/opportunity/anchorReading.ts. Only rows from before 2026-09-14 carry one, since a route now opens only on readable anchors
enum AnchorIssue {
  anchor_missing
  anchor_stale
  anchor_skewed
}

model ArbitrageOpportunity {
  createdAt DateTime @default(now())

  id BigInt @id @default(autoincrement())

  /// PairKey, spelled "BTC|USDT"
  pair  String
  /// RouteKey, so the bid venue and then the ask venue, spelled "bybit-binance"
  route String

  highestBidVenue       String
  highestBidRawMarketId String
  lowestAskVenue        String
  lowestAskRawMarketId  String

  /// The rates actually used, recorded so the row survives a later fee change
  highestBidTakerPpm Int
  lowestAskTakerPpm  Int

  openedAt         DateTime
  netPpmAtOpen     Float
  highestBidAtOpen Float
  lowestAskAtOpen  Float

  closedAt      DateTime
  /// Why the episode ended. Nothing else ends one
  closeReason   OpportunityCloseReason
  /// The last reading before the episode ended, the same measure as netPpmAtOpen taken at the last tick
  netPpmAtClose Float
  /// The last tick that fed this route. A wide gap to closedAt means neither leg changed for that long
  lastSeenAt    DateTime
  durationMs    Int

  /// Ticks folded into this episode. The series below keep the first 10 000 of them, so their length is min(ticks, 10000)
  ticks          Int
  avgNetPpm      Float
  peakNetPpm     Float
  peakAt         DateTime
  /// The two prices read at the tick where netPpm peaked, not the extremes of their own series
  peakHighestBid Float
  peakLowestAsk  Float
  /// The worst reading of the episode, taken from netPpmSeries when the row is built
  minNetPpm      Float

  // One entry per tick, index aligned across all six.
  sampleTsMs         Int[]
  netPpmSeries       Float[]
  highestBidSeries   Float[]
  lowestAskSeries    Float[]
  /// The ladder walk per tick, -1 where a leg held no depth, since a real average edge is never negative
  edgeAvgPpmSeries   Float[]
  edgeNotionalSeries Float[]

  // The ladder walk, docs/bestiary/edge-at-the-touch.md: the average edge over every level pair that still crossed after fees, and the size of that region.
  // Null where a leg held no depth at that moment. Exhausted means a book ran out of held levels first, so size and notional are lower bounds.
  edgeAvgPpmAtOpen     Float?
  edgeSizeAtOpen       Float?
  edgeNotionalAtOpen   Float?
  edgeExhaustedAtOpen  Boolean?
  edgeBuyLevelsAtOpen  Int?
  edgeSellLevelsAtOpen Int?

  /// The sample with the best average edge, not the one where netPpm peaked
  peakEdgeAvgPpm    Float?
  peakEdgeSize      Float?
  peakEdgeNotional  Float?
  peakEdgeExhausted Boolean?
  peakEdgeAt        DateTime?

  edgeAvgPpmAtClose    Float?
  edgeSizeAtClose      Float?
  edgeNotionalAtClose  Float?
  edgeExhaustedAtClose Boolean?

  /// The largest region any sample reached, in the quote asset
  maxEdgeNotional Float @default(0)
  /// Samples where both legs held depth, against ticks for coverage
  edgeSamples     Int   @default(0)

  // The anchors, docs/bestiary/index-mark-and-premium.md: each leg's index, mark and funding as the venue published them, raw and unscaled, read when the route opened.
  // Null on every column only on rows from before 2026-09-14, when a route could open unjudged and anchorIssueAtOpen says why.
  highestBidIndexAtOpen          Float?
  /// Null where the venue publishes no mark, which is coinbase
  highestBidMarkAtOpen           Float?
  /// The bid over the mark minus one as a fraction, over the index without a mark: what the sell book says that its venue has not absorbed
  highestBidFreshPremiumAtOpen   Float?
  /// The rate for the coming settlement as a fraction, -0.0038 = shorts pay longs 0.38%
  highestBidFundingRateAtOpen    Float?
  highestBidFundingIntervalHours Float?
  highestBidNextFundingAt        DateTime?
  /// When the poller wrote the reading
  highestBidAnchorAt             DateTime?
  lowestAskIndexAtOpen           Float?
  lowestAskMarkAtOpen            Float?
  lowestAskFreshPremiumAtOpen    Float?
  lowestAskFundingRateAtOpen     Float?
  lowestAskFundingIntervalHours  Float?
  lowestAskNextFundingAt         DateTime?
  lowestAskAnchorAt              DateTime?
  anchorIssueAtOpen              AnchorIssue?

  /// The net edge once each book is divided by its own anchor, the part a taker cross can capture, and the part the anchors explain
  freshNetPpmAtOpen  Float?
  standingPpmAtOpen  Float?
  /// The two factors inside the standing part: the index gap after the venue price scales, and the accepted premiums' gap. In fractions, 1 + netPpm = (1 + indexGapPpm) × (1 + carriedPpm) × (1 + freshNetPpm)
  indexGapPpmAtOpen  Float?
  carriedPpmAtOpen   Float?
  /// At the sample where netPpm peaked
  freshNetPpmAtPeak  Float?
  standingPpmAtPeak  Float?
  indexGapPpmAtPeak  Float?
  carriedPpmAtPeak   Float?
  freshNetPpmAtClose Float?
  standingPpmAtClose Float?
  indexGapPpmAtClose Float?
  carriedPpmAtClose  Float?

  /// One entry per sample, aligned with sampleTsMs, -2000000 where no anchor could be read at that sample
  freshNetPpmSeries Float[]

  // The anchors over the episode, one entry whenever either leg's index or mark changed, index aligned across the five.
  anchorTsMs            Int[]
  highestBidIndexSeries Float[]
  highestBidMarkSeries  Float[]
  lowestAskIndexSeries  Float[]
  lowestAskMarkSeries   Float[]

  @@index([openedAt])
  @@index([pair, openedAt])
  @@index([freshNetPpmAtOpen])
  @@index([route, openedAt])
  @@index([peakNetPpm])
  @@index([peakEdgeAvgPpm])
  @@index([maxEdgeNotional])
}
